*.springBeans
*.factories

########################
# Docker
########################
# Local Docker build outputs
docker/
docker-compose.override.yml

# Exclude Docker build cache and layers
**/build/
**/.dockerignore

# Prevent accidental inclusion of large images/files
*.tar
*.img

